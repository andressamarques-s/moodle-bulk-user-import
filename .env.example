# Copy this file to .env and adjust.
# {year} is replaced by the current year (e.g. "output/pdf/2026").
PDF_DIR=output/pdf/{year}
CSV_DIR=output/csv/{year}
XLSX_DIR=output/xlsx/{year}

# Initial password written to the CSV and the PDF
DEFAULT_PASSWORD=ChangeMe123!

# CSV delimiter (must match the one chosen on Moodle's upload screen): ; or ,
CSV_DELIMITER=;

# Server (use HOST=0.0.0.0 to let other machines on the network reach it)
HOST=127.0.0.1
PORT=8533
